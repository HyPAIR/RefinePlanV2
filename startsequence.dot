digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
startSequence [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ startSequence", shape=box, style=filled];
SetPickTaraget [fillcolor=gray, fontcolor=black, fontsize=9, label=SetPickTaraget, shape=ellipse, style=filled];
startSequence -> SetPickTaraget;
clearPlacingArea [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ clearPlacingArea", shape=box, style=filled];
startSequence -> clearPlacingArea;
pickObjectBehaviour [fillcolor=gray, fontcolor=black, fontsize=9, label=pickObjectBehaviour, shape=ellipse, style=filled];
startSequence -> pickObjectBehaviour;
pickAndPlace [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ pickAndPlace", shape=box, style=filled];
startSequence -> pickAndPlace;
}
